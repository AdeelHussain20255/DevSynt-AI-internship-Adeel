    {
      "parameters": {
        "jsCode": "// Retrieve output arrays from both Google Sheets nodes\nconst schedule = $('Get Schedule').all().map(item => item.json);\nconst bookings = $('Get Bookings').all().map(item => item.json);\n\n// Create a fast-lookup set of booked slot keys (\"YYYY-MM-DD|Time\")\nconst bookedSlots = new Set(\n  bookings\n    .filter(b => String(b.Status).toLowerCase() === 'confirmed')\n    .map(b => `${b.Date}|${b.Time}`)\n);\n\n// Filter out any schedule slots that are in the booked set\nconst available = schedule.filter(slot => {\n  const key = `${slot.Date}|${slot.Time}`;\n  return !bookedSlots.has(key);\n});\n\nreturn available.map(slot => ({ json: slot }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        192,
        272
      ],
      "id": "7ad227e5-e705-4eb3-a16a-e5e539f72294",
      "name": "Calculate Availability"
    },
    {
      "parameters": {
        "jsCode": "const slots = $input.all().map(item => item.json);\n\n// Group time slots by date\nconst grouped = {};\nslots.forEach(s => {\n  if (!grouped[s.Date]) grouped[s.Date] = [];\n  grouped[s.Date].push(s.Time);\n});\n\n// Format as readable schedule text\nlet summary = \"Available Slots:\\n\";\nfor (const [date, times] of Object.entries(grouped)) {\n  summary += `- ${date}: ${times.join(', ')}\\n`;\n}\n\nreturn [{ json: { available_slots_text: summary } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
